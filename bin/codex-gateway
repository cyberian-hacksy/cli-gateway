#!/usr/bin/env bash
# Run Codex through the encrypted gateway.
#
#   bin/codex-gateway setup                  one-time setup of this machine, then a smoke test
#   bin/codex-gateway [codex arguments...]   run Codex with the "gateway" profile
#   bin/codex-gateway smoke                  send one small request through the whole path
#   bin/codex-gateway status                 show the gateway address and the local bridge state
#   bin/codex-gateway stop                   stop the local bridge
#
# The local bridge is started on demand. Everything runs from the project's own
# virtualenv, so after setup nothing is downloaded at run time.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="$ROOT/.venv/bin/python"
CONFIG="${CGW_CONFIG:-$HOME/.cli-gateway/config.json}"
LOG="$(dirname "$CONFIG")/local-bridge.log"

fail() { echo "error: $*" >&2; exit 1; }

setting() {  # setting <name> [default]: one non-secret value from the local config
  "$PYTHON" -c 'import json,sys
value = json.load(open(sys.argv[1])).get(sys.argv[2])
print(value if value is not None else sys.argv[3])' "$CONFIG" "$1" "${2:-}"
}

listening() {
  "$PYTHON" -c 'import socket,sys
s = socket.socket(); s.settimeout(0.5)
sys.exit(0 if s.connect_ex(("127.0.0.1", int(sys.argv[1]))) == 0 else 1)' "$PORT"
}

bridge_pid() { pgrep -u "$(id -u)" -f "cgw local --config $CONFIG" | head -1; }

# Who holds the bridge's port: 0 = this gateway's bridge (it proved it holds the local
# key), 3 = nobody, anything else = some other program. The bridge starts on demand, so
# the port is usually free and any local process could take it first. Nothing that
# carries the key or a prompt may be sent before this check passes.
bridge_state() {
  local code=0
  "$PYTHON" -m cgw verify-bridge --config "$CONFIG" >/dev/null 2>&1 || code=$?
  return "$code"
}

refuse_impostor() {
  fail "port $PORT on this machine is held by a program that is not this gateway's local bridge.
Nothing was sent to it. Find it with: lsof -nP -iTCP:$PORT -sTCP:LISTEN"
}

start_bridge() {
  local state=0
  bridge_state || state=$?
  if [ "$state" -eq 3 ]; then
    # exec plus full redirection: one detached process that holds none of the caller's pipes.
    (cd "$ROOT" && exec nohup "$PYTHON" -m cgw local --config "$CONFIG" >> "$LOG" 2>&1 < /dev/null &)
    for _ in $(seq 1 100); do
      listening && break
      "$PYTHON" -c 'import time; time.sleep(0.1)'
    done
    # Checked again after starting: the port may have been taken in the meantime.
    state=0
    bridge_state || state=$?
    if [ "$state" -eq 3 ]; then
      echo "error: the local bridge did not start; last lines of $LOG:" >&2
      tail -5 "$LOG" >&2 || true
      exit 1
    fi
  fi
  [ "$state" -eq 0 ] || refuse_impostor
}

if [ "${1:-}" = "setup" ]; then
  if [ ! -x "$PYTHON" ]; then
    command -v uv >/dev/null || fail "uv is required to install the Python environment: https://docs.astral.sh/uv/"
    echo "Installing the Python environment into $ROOT/.venv ..."
    (cd "$ROOT" && uv sync --frozen --no-dev)
  fi
  if [ ! -f "$CONFIG" ]; then
    cat >&2 <<EOF
No gateway configuration at $CONFIG. Choose one:

  1. This machine joins a gateway that already exists:
     ask the gateway's admin for this machine's own config file (they make it with
     python -m cgw add-client <name>), save it as $CONFIG, then run this again.
     It must reach you over a channel you trust: it holds this machine's key.

  2. You are creating a new gateway:
     follow "Deploy your own gateway" in README.md, then run this again.
EOF
    exit 1
  fi
  chmod 700 "$(dirname "$CONFIG")"
  chmod 600 "$CONFIG"
  "$PYTHON" -m cgw install-profile --config "$CONFIG"
  command -v codex >/dev/null || echo "note: 'codex' is not on PATH yet; install the Codex CLI before running bin/codex-gateway"
  PORT="$(setting port 8318)"
  start_bridge
  echo "Sending one small request through the whole path ..."
  cd "$ROOT" && exec "$PYTHON" -m cgw smoke --config "$CONFIG"
fi

[ -x "$PYTHON" ] || fail "this machine is not set up yet; run: bin/codex-gateway setup"
[ -f "$CONFIG" ] || fail "$CONFIG not found; run: bin/codex-gateway setup"
PORT="$(setting port 8318)"

case "${1:-}" in
  status)
    echo "gateway:      $(setting remote_url)"
    state=0
    bridge_state || state=$?
    case "$state" in
      0) echo "local bridge: running on 127.0.0.1:$PORT (pid $(bridge_pid)), identity verified" ;;
      3) echo "local bridge: not running (it starts on demand)" ;;
      *) echo "local bridge: NOT RUNNING, and port $PORT is held by another program. Find it with: lsof -nP -iTCP:$PORT -sTCP:LISTEN" ;;
    esac
    ;;
  stop)
    pid="$(bridge_pid || true)"
    if [ -n "$pid" ]; then kill "$pid" && echo "local bridge stopped"; else echo "local bridge: not running"; fi
    ;;
  smoke)
    start_bridge
    cd "$ROOT" && exec "$PYTHON" -m cgw smoke --config "$CONFIG"
    ;;
  *)
    command -v codex >/dev/null || fail "'codex' is not on PATH; install the Codex CLI first"
    start_bridge
    CGW_LOCAL_API_KEY="$(setting local_key)"
    export CGW_LOCAL_API_KEY
    exec codex --profile gateway "$@"
    ;;
esac
