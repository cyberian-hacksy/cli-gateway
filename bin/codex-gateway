#!/usr/bin/env bash
# Kept for existing setups: bin/codex-gateway is bin/cgw with Codex as the tool.
#
#   bin/codex-gateway setup | smoke | models | status | stop   same as bin/cgw
#   bin/codex-gateway [codex arguments...]                     same as bin/cgw codex
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
case "${1:-}" in
  setup|smoke|models|status|stop) exec "$here/cgw" "$@" ;;
  *) exec "$here/cgw" codex "$@" ;;
esac
