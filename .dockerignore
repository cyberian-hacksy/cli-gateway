# The image is built from an allowlist, so nothing local can leak into a layer.
*
!src
!deploy
**/__pycache__
# Gateway secrets and settings next to the Compose file stay out of the build context.
deploy/**/*.env
deploy/**/.env
# So do machine configs and admin keys, should a copy end up there.
deploy/**/config.json
deploy/**/admin.json
deploy/**/*.admin.json
