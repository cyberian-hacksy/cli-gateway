# Secrets and local state never belong in this repository. The real ones live in
# ~/.cli-gateway/ and in the hosting platform's service variables; these patterns are a
# second line of defence in case a copy ends up in the working tree.
.env
.env.*
config.json
*.pem
*.key
*_ed25519
*_ed25519.pub
id_rsa*
id_ed25519*
*.sqlite
*.sqlite-journal
auth/
*.log
*.envelope

# Source documents and private notes that are not part of the published project
*.docx
/local/
